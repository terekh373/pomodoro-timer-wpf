<Window x:Class="PomodoroTimer.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:PomodoroTimer.Properties"
        Title="{x:Static p:Strings.AppTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="190" Height="88"
        WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
        ToolTip="{x:Static p:Strings.MiniExpand}"
        MouseLeftButtonDown="OnMouseDown">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="{Binding TitleText}" FontSize="13" HorizontalAlignment="Center"
                   MaxWidth="170" TextTrimming="CharacterEllipsis"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{Binding TimeText}" FontSize="38" FontWeight="SemiBold" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
    </StackPanel>
</Window>
