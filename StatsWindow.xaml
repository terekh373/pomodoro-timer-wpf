<ui:FluentWindow x:Class="PomodoroTimer.StatsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:p="clr-namespace:PomodoroTimer.Properties"
                 Title="{x:Static p:Strings.Stats}"
                 Icon="pack://application:,,,/Assets/app.ico"
                 Width="520" Height="620" MinWidth="440" MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{x:Static p:Strings.Stats}" ShowMinimize="False" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,24">
                <TextBlock Style="{StaticResource Caption}" Text="{x:Static p:Strings.StatsToday}" />
                <TextBlock Text="{Binding TodayText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Style="{StaticResource Caption}" Text="{x:Static p:Strings.StatsWeek}" />
                <TextBlock Text="{Binding WeekText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                <TextBlock Style="{StaticResource Caption}" Text="{x:Static p:Strings.StatsMonth}" />
                <TextBlock Text="{Binding MonthText}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20" />

                <TextBlock Text="{Binding GoalText}" Margin="0,0,0,6" />
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding GoalProgress, Mode=OneWay}" Height="8" Margin="0,0,0,24" />

                <TextBlock Style="{StaticResource Caption}" Text="{x:Static p:Strings.StatsLast7}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Bars}" Height="190">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Bottom" ToolTip="{Binding Tooltip}">
                                <TextBlock Text="{Binding Count}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <Border Width="28" Height="{Binding Height}" HorizontalAlignment="Center" CornerRadius="3,3,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Border Height="1" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="4,0" />
                                <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:Button Content="{x:Static p:Strings.ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,24,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
